---
import Base from '../layouts/Base.astro';

const steps = [
  {
    title: 'Keep your number',
    body: "We set conditional forwarding: your line forwards to the AI receptionist only when you're busy or can't pick up after ~20 seconds, plus full coverage after hours.",
  },
  {
    title: 'We build your receptionist',
    body: 'Your services, prices, service area, and top questions — loaded and tested by us.',
  },
  {
    title: 'You see the proof monthly',
    body: 'One page: calls answered, jobs booked, revenue captured versus what you pay us.',
  },
];

const features = [
  { title: '24/7 call answering', body: 'Overflow, after-hours, weekends. Every caller greeted instantly — no hold, no voicemail.' },
  { title: 'Appointment booking', body: 'Booked straight into your calendar during the call — job type, location, urgency captured.' },
  { title: 'Missed-call text-back', body: 'Anyone who slips through gets a text within 60 seconds — before they dial your competitor.' },
  { title: 'Google review requests', body: 'After each completed job, a review request goes out automatically.' },
  { title: 'Human transfer, always', body: 'Any caller can reach you: the receptionist transfers to your cell on request.' },
  { title: 'The monthly report', body: 'Calls answered, jobs booked, revenue captured vs your fee — one page.' },
];

const report = [
  ['Calls answered by AI', '143'],
  ['After-hours', '51'],
  ['Appointments booked', '27'],
  ['Missed callers texted back < 60s', '38'],
  ['Google reviews generated', '9'],
  ['Est. revenue captured', '$18,400'],
  ['Your monthly investment', '$600'],
];

const trust = [
  {
    title: '30-day money-back guarantee',
    body: "If the first report doesn't show the system paid for itself, cancel and the setup fee comes back.",
  },
  {
    title: 'You keep your number and your data',
    body: 'Your phone number, your customer list, your call history — yours. In writing.',
  },
  {
    title: 'California-compliant by design',
    body: 'CIPA recording consent and AI disclosure built into every call.',
  },
];

const faq = [
  {
    q: "Won't my customers hate talking to a robot?",
    a: "Set it up as overflow only — it picks up the calls you're already missing, and the alternative was your voicemail. It introduces itself honestly as an assistant, and any caller can say \"get me a human\" and be transferred to your cell.",
  },
  {
    q: 'I already have an answering service.',
    a: 'Most charge $1–2 per minute to take a message. This is a flat rate, books the job directly into your calendar instead of leaving you a note, and never puts anyone on hold.',
  },
  {
    q: 'What if it breaks or says something wrong?',
    a: 'Conditional forwarding means your existing line is untouched — rollback takes 10 minutes and we document the deactivation code for you on day one.',
  },
  {
    q: 'Is this legal in California? Recording, AI disclosure?',
    a: 'Yes — because we build it in. Every receptionist we deploy announces itself as an AI assistant and gives the CIPA recording notice up front.',
  },
  {
    q: 'How fast can I be live?',
    a: 'Five business days from kickoff call to launch, usually faster. Soft launch on after-hours first, then full overflow once the transcripts are clean.',
  },
];
---

<Base
  title="AI Answering Service in LA - Pacific Front Desk"
  description="Pacific Front Desk answers your business line 24/7, books jobs into your calendar, and texts back missed calls in under 60 seconds. Flat rate, LA-based, CIPA-compliant."
  ogImage="/og/answering-service.png"
>
  {/* Header */}
  <div class="border-b border-day-hairline">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
      <a href="/" class="font-display text-[15px] font-bold tracking-[0.06em] text-day-text">PACIFIC FRONT DESK</a>
      <div class="flex items-center gap-6">
        <span class="hidden text-[15px] text-day-muted sm:inline">oleg@pacificfrontdesk.com</span>
        <a href="tel:+17472497607" class="font-display font-semibold text-pacific">(747) 249-7607</a>
      </div>
    </div>
  </div>

  {/* Hero */}
  <section class="section-pad">
    <div class="mx-auto flex max-w-6xl flex-col gap-7 px-6">
      <p class="type-label text-pacific">AI-powered answering for home-service businesses</p>
      <h1 class="type-hero max-w-[16ch]">Your business never misses another call.</h1>
      <p class="measure text-xl leading-relaxed text-day-muted">
        A managed receptionist that answers 24/7, books jobs straight into your
        calendar, and texts back every missed call. You keep your number. You
        keep the revenue.
      </p>
      <div class="mt-1 flex flex-wrap items-center gap-6">
        <a href="tel:+14247993449" class="btn-primary">Hear it answer: (424) 799-3449</a>
        <a href="#pricing" class="link-day">Pricing</a>
      </div>
      <p class="text-sm text-day-muted">Los Angeles · San Fernando Valley · Orange County</p>
    </div>
  </section>

  {/* Steps */}
  <section class="section-pad border-t border-day-hairline">
    <div class="mx-auto flex max-w-6xl flex-col gap-12 px-6">
      <h2 class="type-section">Up and running in three steps</h2>
      <div class="grid gap-10 md:grid-cols-3">
        {
          steps.map((step, i) => (
            <div class="flex flex-col gap-3">
              <p class="font-display text-[15px] font-bold text-pacific">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="type-item">{step.title}</h3>
              <p class="text-day-muted">{step.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* Features */}
  <section class="section-pad border-t border-day-hairline">
    <div class="mx-auto flex max-w-6xl flex-col gap-12 px-6">
      <h2 class="type-section">What you get</h2>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map((feature) => (
            <div class="card flex flex-col gap-3 p-7">
              <h3 class="font-semibold">{feature.title}</h3>
              <p class="text-[15px] text-day-muted">{feature.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* Report */}
  <section class="section-pad border-t border-day-hairline">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 lg:grid-cols-2">
      <div class="flex flex-col gap-5">
        <h2 class="type-section max-w-[18ch]">You see exactly what it earns</h2>
        <p class="measure text-day-muted">
          Once a month, one page: how many calls came in, how many turned into
          booked jobs, and what that revenue looks like next to the bill. If
          the math stops working, you'll see it before we do.
        </p>
      </div>
      <div class="card p-8">
        <p class="type-label pb-4 text-day-muted">Sample month</p>
        <dl>
          {
            report.map(([label, value]) => (
              <div class="flex items-baseline justify-between border-t border-day-hairline py-3">
                <dt class="text-[15px] text-day-muted">{label}</dt>
                <dd class="font-semibold tabular-nums">{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  {/* Trust */}
  <section class="section-pad border-t border-day-hairline">
    <div class="mx-auto grid max-w-6xl gap-10 px-6 md:grid-cols-3">
      {
        trust.map((item) => (
          <div class="flex flex-col gap-3">
            <h2 class="type-item">{item.title}</h2>
            <p class="text-[15px] text-day-muted">{item.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  {/* Pricing */}
  <section id="pricing" class="section-pad border-t border-day-hairline">
    <div class="mx-auto flex max-w-6xl flex-col gap-12 px-6">
      <h2 class="type-section">Pricing, out loud</h2>
      <div class="grid max-w-4xl gap-5 md:grid-cols-2">
        <div class="flex flex-col gap-4 rounded-card border-2 border-pacific bg-card p-9">
          <p class="type-label self-start rounded-full bg-pacific px-3 py-1.5 text-white">Founding clients · 5 spots</p>
          <p class="font-display text-3xl font-semibold">
            $400<span class="text-lg font-medium text-day-muted">/month, locked for 6 months</span>
          </p>
          <p class="text-day-muted">$500 setup — credited back in full on your third month.</p>
          <a href="tel:+17472497607" class="btn-primary mt-2 self-start">Claim a founder spot</a>
        </div>
        <div class="card flex flex-col gap-4 p-9">
          <p class="type-label self-start rounded-full bg-badge px-3 py-1.5 text-day-muted">After that</p>
          <p class="font-display text-3xl font-semibold">
            $600+<span class="text-lg font-medium text-day-muted">/month</span>
          </p>
          <p class="text-day-muted">$1,000+ setup, scoped to your call volume and services.</p>
        </div>
      </div>
    </div>
  </section>

  {/* FAQ */}
  <section class="section-pad border-t border-day-hairline">
    <div class="mx-auto flex max-w-6xl flex-col gap-10 px-6">
      <h2 class="type-section">Questions owners actually ask</h2>
      <div class="max-w-3xl divide-y divide-day-hairline border-y border-day-hairline">
        {
          faq.map((item, i) => (
            <div>
              <h3>
                <button
                  type="button"
                  aria-expanded="true"
                  aria-controls={`faq-panel-${i}`}
                  data-faq-trigger
                  class="flex w-full items-center justify-between gap-6 py-5 text-left text-lg font-medium"
                >
                  <span>{item.q}</span>
                  <svg width="14" height="9" viewBox="0 0 14 9" aria-hidden="true" class="shrink-0 text-pacific">
                    <path d="M1 1l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                  </svg>
                </button>
              </h3>
              <div id={`faq-panel-${i}`} class="pb-6">
                <p class="measure text-day-muted">{item.a}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="bg-pacific">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-8 px-6 py-16 md:flex-row md:items-center md:justify-between">
      <h2 class="type-section text-white">Stop paying for missed calls.</h2>
      <div class="flex flex-wrap items-center gap-6">
        <a href="tel:+17472497607" class="inline-block rounded-control bg-white px-7 py-4 font-display font-semibold text-day-text">
          Call (747) 249-7607
        </a>
        <a href="mailto:oleg@pacificfrontdesk.com" class="font-medium text-white underline underline-offset-4">
          oleg@pacificfrontdesk.com
        </a>
      </div>
    </div>
  </section>

  {/* Footer */}
  <footer class="night bg-ink">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-10 text-sm text-night-muted">
      <div class="flex flex-col justify-between gap-4 md:flex-row md:items-center">
        <p>© 2026 Pacific Front Desk LLC · Los Angeles, CA</p>
        <a href="https://nattskiftgames.com" rel="noopener" class="inline-flex items-center gap-3 text-royal-light">
          <svg width="18" height="18" viewBox="0 0 512 512" aria-hidden="true"><rect x="0" y="0" width="512" height="256" fill="#0B0E12" stroke="#201B2E" stroke-width="8"></rect><rect x="0" y="256" width="512" height="256" fill="#6B3FA0"></rect><path fill="#FFFFFF" d="M186 58 L232 58 L292 166 L292 58 L326 58 L326 198 L280 198 L220 90 L220 198 L186 198 Z"></path></svg>
          Nattskift Games — made on the night shift
        </a>
      </div>
      <p class="max-w-4xl text-[13px] leading-relaxed">
        Every AI receptionist we deploy discloses that it is an AI assistant
        and announces call recording in accordance with California law,
        including CIPA (California Invasion of Privacy Act).
      </p>
    </div>
  </footer>
</Base>
